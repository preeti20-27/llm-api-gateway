<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.llmgateway</groupId>
    <artifactId>llm-api-gateway</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>llm-api-gateway</name>
    <description>LLM API Gateway - Spring Boot proxy with auth, rate limiting, caching and failover</description>

    <properties>
        <java.version>21</java.version>
        <!-- Spring Boot 3.2.5 manages Testcontainers 1.19.7, whose bundled docker-java
             client can't talk to newer Docker Desktop builds (observed: HTTP 400 against
             Docker Engine API 1.54 / Docker Desktop 4.78 on Windows). Pinned forward to
             the latest 1.x release, which stays source-compatible with the 1.x API used
             in these tests. -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- Not managed by Spring Boot's own BOM, so pinned explicitly. -->
        <resilience4j.version>2.2.0</resilience4j.version>
    </properties>

    <dependencies>
        <!-- Web layer: REST controllers + embedded Tomcat. Spring Boot 3.2's RestClient
             (used by GeminiProvider) ships in this starter, no extra dependency needed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation (@NotBlank etc.) for request DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Phase 2: API-key storage (Postgres via JPA) + Spring Security for the
             X-API-Key authentication filter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Phase 3: Redis client for distributed rate limiting (token bucket via Lua) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Phase 5: circuit breaker + retry + timeout around the primary (Gemini)
             provider. resilience4j-spring-boot3 wires @CircuitBreaker/@Retry/@TimeLimiter
             as Spring AOP method interceptors, which needs an AOP proxy — hence the
             explicit spring-boot-starter-aop alongside it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: spins up a real Postgres in Docker for integration tests,
             so tests exercise the actual Flyway migration + JPA + security filter chain
             instead of an in-memory substitute like H2 that could behave differently. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
