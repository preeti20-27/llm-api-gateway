# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Google Gemini API key (free tier). Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides — defaults are set in application.yml
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_MODEL=gemini-1.5-flash

# Postgres (docker compose up -d postgres starts a matching local instance)
DB_URL=jdbc:postgresql://localhost:5432/llm_gateway
DB_USERNAME=llm_gateway
DB_PASSWORD=llm_gateway

# Required to call POST /admin/keys — send it back as the X-Admin-Token header.
# If unset, admin endpoints reject every request (fail closed), they are never
# accidentally left open. Generate one with: openssl rand -hex 32
ADMIN_TOKEN=your-admin-token-here

# Redis (docker compose up -d redis starts a matching local instance) — used for
# rate limiting. Per-tier limits themselves live in application.yml, not here.
# REDIS_HOST=localhost
# REDIS_PORT=6379
